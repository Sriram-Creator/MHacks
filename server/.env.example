# Copy this file to .env and fill in your key.
# NVIDIA NIM API key (starts with "nvapi-") for the vision LLM call.
# Get one at https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here

# Optional overrides
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Force mock listings even when a key is present. If NVIDIA_API_KEY is empty,
# mock mode is used automatically.
MOCK_AI=false

PORT=3001

# Neon Postgres connection string (required). Create a database at
# https://neon.tech and paste the connection string here.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
