# Copy this file to .env and fill in your key.
# Google Gemini API key used for the vision LLM call.
GEMINI_API_KEY=your-gemini-key-here

# Optional overrides
GEMINI_MODEL=gemini-1.5-flash

# Force mock listings even when a key is present. If GEMINI_API_KEY is empty,
# mock mode is used automatically.
MOCK_AI=false

PORT=3001
